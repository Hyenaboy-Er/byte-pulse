# Claude API key (https://console.anthropic.com/) — required for the Writer + Reviewer agents
ANTHROPIC_API_KEY=sk-ant-...

# Database
# Local dev:    file:./dev.db                                                (SQLite)
# Production:   libsql://your-db-name.turso.io  + DATABASE_AUTH_TOKEN below   (Turso, cloud)
DATABASE_URL="file:./dev.db"
# Only needed when DATABASE_URL is libsql://
DATABASE_AUTH_TOKEN=

# Public site URL (used for sitemap, RSS, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=TechPuls
NEXT_PUBLIC_SITE_TAGLINE="Tech-News, Gaming, KI – alles was heute zählt."

# Cron secret (required to trigger /api/cron from outside, e.g. Vercel Cron)
CRON_SECRET=change-me-to-a-long-random-string

# Optional: AdSense client ID (leave blank to hide ads)
NEXT_PUBLIC_ADSENSE_CLIENT=

# Optional: Resend API key for newsletter delivery (leave blank to just collect emails)
RESEND_API_KEY=
NEWSLETTER_FROM="TechPuls <hi@example.com>"

# Optional: Email-Watcher agent (Gmail IMAP poll → Telegram alerts every 30min)
# 1. Enable 2FA on the Gmail account
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. Add the cron at cron-job.org: GET /api/email-watch?token=$CRON_SECRET (every 30 min)
GMAIL_IMAP_USER=
GMAIL_IMAP_PASSWORD=
