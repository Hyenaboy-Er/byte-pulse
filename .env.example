# LLM provider — controls which model runs the writer/humanizer/reviewer/translator.
# All three options use an OpenAI-compatible API, so swap providers in one env var.
#   openai   (default) — set OPENAI_API_KEY
#   gemini   25-50x cheaper than GPT-4o, similar quality — set GEMINI_API_KEY
#   deepseek 15-25x cheaper than GPT-4o, good for editing — set DEEPSEEK_API_KEY
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Per-role model overrides (advanced). When unset, sensible defaults for the
# active provider are used. Useful e.g. to run writer on Gemini 2.5 Pro but
# reviewer on Flash-Lite for cost.
# LLM_WRITER_MODEL=gemini-2.5-pro
# LLM_HUMANIZER_MODEL=gemini-2.5-flash
# LLM_REVIEWER_MODEL=gemini-2.5-flash-lite
# LLM_TRANSLATOR_MODEL=gemini-2.5-flash

# Claude API key (legacy — only needed if you re-enable the old Anthropic path)
ANTHROPIC_API_KEY=sk-ant-...

# Database
# Local dev:    file:./dev.db                                                (SQLite)
# Production:   libsql://your-db-name.turso.io  + DATABASE_AUTH_TOKEN below   (Turso, cloud)
DATABASE_URL="file:./dev.db"
# Only needed when DATABASE_URL is libsql://
DATABASE_AUTH_TOKEN=

# Public site URL (used for sitemap, RSS, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=TechPuls
NEXT_PUBLIC_SITE_TAGLINE="Tech-News, Gaming, KI – alles was heute zählt."

# Cron secret (required to trigger /api/cron from outside, e.g. Vercel Cron)
CRON_SECRET=change-me-to-a-long-random-string

# Optional: AdSense client ID (leave blank to hide ads)
NEXT_PUBLIC_ADSENSE_CLIENT=

# Optional: Resend API key for newsletter delivery (leave blank to just collect emails)
RESEND_API_KEY=
NEWSLETTER_FROM="TechPuls <hi@example.com>"

# Optional: Email-Watcher agent (Gmail IMAP poll → Telegram alerts every 30min)
# 1. Enable 2FA on the Gmail account
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. Add the cron at cron-job.org: GET /api/email-watch?token=$CRON_SECRET (every 30 min)
GMAIL_IMAP_USER=
GMAIL_IMAP_PASSWORD=
