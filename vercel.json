{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron?batch=20",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/daily",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/route.ts": { "maxDuration": 60 },
    "src/app/api/admin/run/route.ts": { "maxDuration": 60 },
    "src/app/api/admin/monitor/route.ts": { "maxDuration": 60 },
    "src/app/api/daily/route.ts": { "maxDuration": 60 },
    "src/app/api/newsletter/send/route.ts": { "maxDuration": 60 }
  }
}
